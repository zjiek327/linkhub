@echo off
rem LinkHub SYSTEM 启动包装（任务计划程序 InteractiveToken 调用本脚本）
rem 1. 复制本文件为 run-as-system.bat，填入实际值
rem 2. 注意：SYSTEM 账户的 linkhub 数据目录在
rem    C:\Windows\System32\config\systemprofile\.linkhub（节点 ID 会重新生成，
rem    如需保留原节点身份，把原用户目录下 .linkhub 整个拷到上述路径）
rem
rem 集群对端地址务必选 LAPTOP 本机网络可达的那个：
rem   39 服务器是双网卡（10.218.146.39 服务器网段 + 10.110.20.149 办公网段），
rem   LAPTOP 所在网段到 10.218.146.39 被 ACL 拦截（定向加入 context deadline exceeded），
rem   但到 10.110.20.149 双向可达——所以 PEERS/SEEDS 必须写 10.110.20.149:8000
set LINKHUB_CLUSTER_TOKEN=CHANGE_ME
set LINKHUB_NODE_NAME=LAPTOP
set LINKHUB_CLUSTER_ENABLED=true
set LINKHUB_CLUSTER_PEERS=http://10.110.20.149:8000
set LINKHUB_CLUSTER_SEEDS=10.110.20.149:8000

rem 远程桌面：半分辨率采集（2K/4K 屏延迟优先）；要全清晰度删掉下一行
set LINKHUB_DESKTOP_SCALE=0.5

rem exe 定位：本脚本同目录优先，其次仓库布局的上级 backend\
set "EXE=%~dp0linkhub.exe"
if not exist "%EXE%" set "EXE=%~dp0..\backend\linkhub.exe"

rem 日志落盘（SYSTEM 任务无控制台，不重定向则崩溃/报错无处可查），与脚本同目录
"%EXE%" >> "%~dp0linkhub.log" 2>&1
